# Optional configuration for scripts/plan-usage-after-vpn.
# Install this file as ~/.config/plan-usage/vpn.env and edit the values.
# Values use shell assignment syntax; do not put secrets in this file.

# Flatpak application ID used to start the VPN client.
PLAN_USAGE_VPN_APP='com.surfshark.Surfshark'
# Whitespace-separated arguments passed to `flatpak run`.
PLAN_USAGE_VPN_APP_ARGS='--background'

# Only interfaces matching this extended regular expression are accepted.
PLAN_USAGE_VPN_INTERFACE_REGEX='^(surfshark(_wg)?|wg[-_]surfshark)$'

# Must be an HTTPS URL reachable through the VPN interface.
PLAN_USAGE_VPN_HEALTH_URL='https://www.codebuff.com/'
PLAN_USAGE_VPN_TIMEOUT=180
PLAN_USAGE_VPN_POLL_SECONDS=2
PLAN_USAGE_VPN_STATUS_INTERVAL_SECONDS=10

# Leave empty to skip the desktop-panel readiness check. Otherwise list every
# process that must exist before the tray is started.
PLAN_USAGE_VPN_TRAY_PROCESSES='snixembed polybar'

# Path to the already-built project binary.
PLAN_USAGE_BIN="${HOME}/.local/bin/plan-usage"
